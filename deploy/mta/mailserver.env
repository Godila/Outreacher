# docker-mailserver: лёгкий профиль под кампейн-MTA (см. deploy/mta/README.md)
OVERRIDE_HOSTNAME=mta-news.adel-factory.ru
DMS_DEBUG=0

# Антивирус/антиспам выключены — лёгкость и скорость (Rspamd при необходимости позже)
ENABLE_CLAMAV=0
ENABLE_SPAMASSASSIN=0
ENABLE_FAIL2BAN=1
ENABLE_POSTGREY=0

# Протоколы
ENABLE_IMAP=1
ENABLE_POP3=0
SMTP_ONLY=0
SSL_TYPE=letsencrypt

# DKIM (селектор по умолчанию: mail)
ENABLE_OPENDKIM=1
DKIM_KEY_LENGTH=2048

# Не релеить для чужих сетей
PERMIT_DOCKER=none
RELAY_HOST=

# Отчёты о проблемах доставки — на постмастера
REPORT_RECIPIENT=admin@adel-hat.ru
REPORT_INTERVAL=daily

POSTMASTER_ADDRESS=postmaster@news.adel-hat.ru
